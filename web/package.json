{
  "name": "three-in-line-web",
  "private": true,
  "version": "0.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run --config \"$PWD/vitest.config.ts\" --root \"$PWD/..\" --coverage",
    "test:watch": "vitest --config \"$PWD/vitest.config.ts\" --root \"$PWD/..\"",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.node.json",
    "deploy:pages": "wrangler pages deploy dist --project-name \"$CLOUDFLARE_PAGES_PROJECT\"",
    "deploy": "bun run build && bun run deploy:pages"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@base-ui/react": "^1.9.0",
    "@convex-dev/auth": "^0.0.96",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.48.0",
    "lucide-react": "^1.64.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "vaul": "^1.1.2"
  },
  "overrides": {
    "@dotenvx/dotenvx>undici": "7.30.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
